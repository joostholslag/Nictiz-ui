uded>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences><node_id>at0069</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence><match_negated>false</match_negated><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_TEXT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id></node_id></children></attributes></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>false</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>1</lower></interval></cardinality></attributes></children></attributes><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>protocol</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence><match_negated>false</match_negated><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ITEM_TREE</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0032</node_id><attributes xsi:type="C_MULTIPLE_ATTRIBUTE"><rm_attribute_name>items</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence><match_negated>false</match_negated><children xsi:type="ARCHETYPE_SLOT"><rm_type_name>CLUSTER</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>false</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></occurrences><node_id>at0071</node_id><includes><string_expression>archetype_id/value matches {/.*/}</string_expression><expression xsi:type="EXPR_BINARY_OPERATOR"><type>Boolean</type><operator>2007</operator><precedence_overridden>false</precedence_overridden><left_operand xsi:type="EXPR_LEAF"><type>String</type><item xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:string">archetype_id/value</item><reference_type>attribute</reference_type></left_operand><right_operand xsi:type="EXPR_LEAF"><type>String</type><item xsi:type="C_STRING"><pattern>.*</pattern></item><reference_type>constraint</reference_type></right_operand></expression></includes></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>false</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes></children></attributes><archetype_id><value>openEHR-EHR-EVALUATION.problem_diagnosis.v1</value></archetype_id><term_definitions code="at0000"><items id="text">Problem/Diagnosis</items><items id="description">Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.</items><items id="comment">Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.</items></term_definitions><term_definitions code="at0001"><items id="text">structure</items><items id="description">@ internal @</items></term_definitions><term_definitions code="at0002"><items id="text">Diagnosis</items><items id="description">Identification of the problem or diagnosis, by name.</items><items id="comment">Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.</items></term_definitions><term_definitions code="at0003"><items id="text">Date/time clinically recognised</items><items id="description">Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.</items><items id="comment">Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.</items></term_definitions><term_definitions code="at0005"><items id="text">Severity</items><items id="description">An assessment of the overall severity of the problem or diagnosis.</items><items id="comment">If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.</items></term_definitions><term_definitions code="at0009"><items id="text">Clinical description</items><items id="description">Narrative description about the problem or diagnosis.</items><items id="comment">Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.</items></term_definitions><term_definitions code="at0012"><items id="text">Body site</items><items id="description">Identification of a simple body site for the location of the problem or diagnosis.</items><items id="comment">Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.</items></term_definitions><term_definitions code="at0030"><items id="text">Date/time of resolution</items><items id="description">Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.</items><items id="comment">Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.&#13;
</items></term_definitions><term_definitions code="at0032"><items id="text">Tree</items><items id="description">@ internal @</items></term_definitions><term_definitions code="at0039"><items id="text">Structured body site</items><items id="description">A structured anatomical location for the problem or diagnosis.</items><items id="comment">Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.</items></term_definitions><term_definitions code="at0043"><items id="text">Specific details</items><items id="description">Details that are additionally required to record as unique attributes of this problem or diagnosis.</items><items id="comment">May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.</items></term_definitions><term_definitions code="at0046"><items id="text">Status</items><items id="description">Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.</items><items id="comment">Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.</items></term_definitions><term_definitions code="at0047"><items id="text">Mild</items><items id="description">The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.</items></term_definitions><term_definitions code="at0048"><items id="text">Moderate</items><items id="description">The problem or diagnosis causes interference with normal activity or will damage health if left untreated.</items></term_definitions><term_definitions code="at0049"><items id="text">Severe</items><items id="description">The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.</items></term_definitions><term_definitions code="at0069"><items id="text">Comment</items><items id="description">Additional narrative about the problem or diagnosis not captured in other fields.</items></term_definitions><term_definitions code="at0070"><items id="text">Last updated</items><items id="description">The date this problem or diagnosis was last updated.</items></term_definitions><term_definitions code="at0071"><items id="text">Extension</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items></term_definitions><term_definitions code="at0072"><items id="text">Course description</items><items id="description">Narrative description about the course of the problem or diagnosis since onset.</items></term_definitions><term_definitions code="at0073"><items id="text">Diagnostic certainty</items><items id="description">The level of confidence in the identification of the diagnosis.</items><items id="comment">If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.</items></term_definitions><term_definitions code="at0074"><items id="text">Suspected</items><items id="description">The diagnosis has been identified with a low level of certainty.</items></term_definitions><term_definitions code="at0075"><items id="text">Probable</items><items id="description">The diagnosis has been identified with a high level of certainty.</items></term_definitions><term_definitions code="at0076"><items id="text">Confirmed</items><items id="description">The diagnosis has been confirmed against recognised criteria.</items></term_definitions><term_definitions code="at0077"><items id="text">Date/time of onset</items><items id="description">Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.</items><items id="comment">Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.</items></term_definitions><term_definitions code="at0078"><items id="text">Cause</items><items id="description">A cause, set of causes, or manner of causation of the problem or diagnosis.</items><items id="comment">Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.</items></term_definitions></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>false</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>1</lower></interval></cardinality></attributes><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>name</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><match_negated>false</match_negated><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_TEXT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id></node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><match_negated>false</match_negated><children xsi:type="C_PRIMITIVE_OBJECT"><rm_type_name>STRING</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id></node_id><item xsi:type="C_STRING"><list>Problem</list></item></children></attributes></children></attributes><archetype_id><value>openEHR-EHR-SECTION.adhoc.v1</value></archetype_id><term_definitions code="at0000"><items id="text">Problem</items><items id="description">A generic section header which should be renamed in a template to suit a specific clinical context.</items></term_definitions></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>false</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>1</lower></interval></cardinality></attributes><archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><template_id><value>Vital Signs Lite</value></template_id><term_definitions code="at0000"><items id="text">Vital Signs Lite</items><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items></term_definitions><term_definitions code="at0001"><items id="text">Tree</items><items id="description">@ internal @</items></term_definitions><term_definitions code="at0002"><items id="text">Extension</items><items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items><items id="comment">e.g. Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.</items></term_definitions></definition><ontology archetype_id="openEHR-EHR-COMPOSITION.encounter.v1"><term_definitions language="de"><items code="at0000"><items id="text">Begegnung</items><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s). (en)</items></items><items code="at0001"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Erweiterung</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms. (en)</items><items id="comment">*e.g. Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents. (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Vital Signs Lite</items><items id="description">Interaktion, kontakt eller vårdhändelse mellan vårdtagare och vårdgivare inom hälso- och sjukvården.</items></items><items code="at0001"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Extra information</items><items id="description">Extra information som krävs för att fånga lokal kontext eller för anpassning till andra referensmodeller och formalismer.</items><items id="comment">Exempelvis information om en lokal sjukhusavdelning eller ytterligare metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items></items></term_definitions></ontology><component_ontologies archetype_id="openEHR-EHR-SECTION.adhoc.v1"><term_definitions language="de"><items code="at0000"><items id="text">Überschrift</items><items id="description">*A generic section header which should be renamed in a template to suit a specific clinical context. (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Rubrik</items><items id="description">En generisk avsnittsrubrik som döps om i en template för att passa in i en specifik klinisk kontext.</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1"><term_definitions language="de"><items code="at0000"><items id="text">Problem/Diagnose</items><items id="description">Angaben über einen einzelnen identifizierten Gesundheitszustand, eine Verletzung, eine Behinderung oder ein Problem, welches das körperliche, geistige und/oder soziale Wohlergehen einer Einzelperson beeinträchtigt.</items><items id="comment">Eine klare Abgrenzung zwischen Problem und Diagnose ist in der Praxis nicht einfach zu erreichen. Für die Zwecke der klinischen Dokumentation mit diesem Archetyp werden Problem und Diagnose als ein Kontinuum betrachtet, mit zunehmendem Detaillierungsgrad und unterstützenden Beweisen, die in der Regel dem Etikett "Diagnose" Gewicht verleihen.</items></items><items code="at0001"><items id="text">Structure</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Name des Problems/ der Diagnose</items><items id="description">Namentliche Identifikation des Problems oder der Diagnose.</items><items id="comment">Wo möglich, ist die Kodierung des Problems oder der Diagnose über eine Terminologie zu bevorzugen.</items></items><items code="at0003"><items id="text">Datum/Zeitpunkt der klinischen Feststellung</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Diagnose oder das Problem von einer medizinischen Fachkraft festgestellt wurde.</items><items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der klinischen Feststellung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items></items><items code="at0005"><items id="text">Schweregrad</items><items id="description">Eine Gesamtbeurteilung des Schweregrades des Problems oder der Diagnose.</items><items id="comment">Ist der Schweregrad über vordefinierte Codes im Element "Name des Problems/ der Diagnose" enthalten, wird dieses Datenelement überflüssig. Hinweis: Eine spezifischere Einstufung des Schweregrads kann mit Hilfe des SLOTs "Spezifische Angaben" angegeben werden.</items></items><items code="at0009"><items id="text">Klinische Beschreibung</items><items id="description">Beschreibung des Problems oder der Diagnose.</items><items id="comment">Wird verwendet, um Hintergrund und Kontext, einschließlich Entwicklung, Episoden oder Verschlechterungen, Fortschritt und andere relevante Details über das Problem oder die Diagnose zu liefern.</items></items><items code="at0012"><items id="text">Körperstelle</items><items id="description">Identifikation einer einfachen Körperstelle zur Lokalisierung des Problems oder der Diagnose.</items><items id="comment">Wo dies möglich ist, ist die Kodierung der anatomischen Lokalisation über eine Terminologie zu bevorzugen. Verwenden Sie dieses Datenelement, um vorab präkoordinierte anatomische Lokalisationen zu erfassen. Wenn die Anforderungen an die Erfassung der anatomischen Lokalisation zur Laufzeit durch die Anwendung bestimmt werden oder komplexere Modellierungen, wie z.B. relative Lokalisationen erforderlich sind, dann verwenden Sie in diesem Archetyp den CLUSTER.anatomical_location oder CLUSTER.relative_location innerhalb des SLOT 'Structured anatomical location'. Die Anzahl für dieses Datenelement ist unbegrenzt, um klinische Szenarien wie die Beschreibung eines Hautausschlags an mehreren Stellen zu ermöglichen, wobei jedoch alle anderen Attribute identisch sind. Falls die anatomische Lage über präkoordinierte Codes im Namen des Problems/Diagnose enthalten ist, wird dieses Datenelement überflüssig.</items></items><items code="at0030"><items id="text">Datum/Zeitpunkt der Genesung</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der von einer medizinischen Fachkraft die Genesung oder die Remission des Problems oder der Diagnose festgestellt wurde.</items><items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der Genesung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items></items><items code="at0032"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0039"><items id="text">Anatomische Stelle (strukturiert)</items><items id="description">Eine strukturierte anatomische Lokalisation des Problems oder der Diagnose.</items><items id="comment">Verwenden Sie diesen SLOT, um die Archetypen CLUSTER.anatomical_location oder CLUSTER.relative_location einzufügen, wenn die Anforderungen für die Aufnahme der anatomischen Position zur Laufzeit der Anwendung bestimmt werden oder komplexere Modellierungen wie z.B. relative Positionen erforderlich sind. Ist die anatomische Lokalisation über präkoordinierte Codes im Namen des Problems/Diagnose enthalten, wird die Verwendung dieses SLOT überflüssig.</items></items><items code="at0043"><items id="text">Spezifische Angaben</items><items id="description">Zusätzlich benötigte Angaben, welche als eindeutige Merkmale des Problem/der Diagnose erfasst werden sollten.</items><items id="comment">Hier können strukturierte Angaben über die Einstufung oder das Stadium der Diagnose enthalten sein; diagnostische Kriterien, Klassifizierungskriterien oder formale Bewertungen des Schweregrades wie z.B. "Common Terminology Criteria for Adverse Events".</items></items><items code="at0046"><items id="text">Status</items><items id="description">Strukturierte Angaben zu standort-, domänen-, episoden- oder workflow-spezifischen Aspekten des diagnostischen Prozesses.</items><items id="comment">Verwenden Sie Status- oder Kontext-Merkmale mit Vorsicht, da sie in der Praxis variabel eingesetzt werden und die Interoperabilität nicht gewährleistet werden kann, sofern die Verwendung nicht mit der Nutzungsgemeinschaft klar abgestimmt wird. Beispiel: aktiver Status - aktiv, inaktiv, genesen, in Remission; Entwicklungsstatus - initial, interim/working, final; zeitlicher Status - aktuell, vergangen; Episodenstatus - erstmalig, neu, laufend; Aufnahmestatus - Aufnahme, Entlassung; oder Prioritätsstatus - primär, sekundär.</items></items><items code="at0047"><items id="text">Leicht</items><items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität nicht, bzw. verursacht nicht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items></items><items code="at0048"><items id="text">Mäßig</items><items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität oder verursacht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items></items><items code="at0049"><items id="text">Schwer</items><items id="description">Das Problem oder die Diagnose verhindert die normale Aktivität oder verursacht schwerwiegende gesundheitliche Schäden, falls es nicht behandelt wird.</items></items><items code="at0069"><items id="text">Kommentar</items><items id="description">Ergänzende Beschreibung des Problems oder der Diagnose, die nicht anderweitig erfasst wurde.</items></items><items code="at0070"><items id="text">Zuletzt aktualisiert</items><items id="description">Datum der letzten Aktualisierung der Diagnose bzw. des Problems.</items></items><items code="at0071"><items id="text">Erweiterung</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items></items><items code="at0072"><items id="text">Beschreibung des Verlaufs</items><items id="description">Beschreibung des Problem-/ Diagnoseverlaufs seit Beginn.</items></items><items code="at0073"><items id="text">Diagnostische Sicherheit</items><items id="description">Grad der Sicherheit, mit der die Diagnose festgestellt wurde.</items><items id="comment">Wenn ein alternativer Wertesatz benötigt wird, können diese Werte in einem Template zum Datentyp DV_TEXT hinzugefügt werden.</items></items><items code="at0074"><items id="text">Vermutet</items><items id="description">Die Diagnose wurde mit einem niedrigen Grad an Sicherheit gestellt.</items></items><items code="at0075"><items id="text">Wahrscheinlich</items><items id="description">Die Diagnose wurde mit einem hohen Maß an Sicherheit gestellt.</items></items><items code="at0076"><items id="text">Bestätigt</items><items id="description">Die Diagnose wurde anhand anerkannter Kriterien bestätigt.</items></items><items code="at0077"><items id="text">Datum/ Zeitpunkt des Auftretens/ der Erstdiagnose</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Krankheitsanzeichen oder Symptome zum ersten mal beobachtet wurden.</items><items id="comment">Datumswerte, die als "Alter zu Beginn" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items></items><items code="at0078"><items id="text">Ursache</items><items id="description">Die Ursache, eine Reihe von Ursachen oder eine Art und Weise der Verursachung des Problems oder der Diagnose.</items><items id="comment">Auch bekannt als „Ätiologie“. Die Codierung mit einer externen Terminologie wird nach Möglichkeit bevorzugt.</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Problem/Diagnos</items><items id="description">Detaljer av ett enskilt identifierat hälsotillstånd, skada, funktionshinder eller något annat problem som påverkar individens fysiska, psykiska och eller sociala välbefinnande.</items><items id="comment">Det är inte lätt att i praktiken uppnå en tydlig avgränsning mellan ett problem och en diagnos. Vid tillämpning av klinisk dokumentation med denna arketyp betraktas problem och diagnos som ett kontinuum, med plats för fler detaljer och stödjande bevis som vanligtvis ger tyngd till etiketten ”diagnos”.</items></items><items code="at0001"><items id="text">structure</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Problem/Diagnos namn</items><items id="description">Identifiering av problemet eller diagnosen efter namn.</items><items id="comment">Kodning av namnet på problemet eller diagnosen med en terminologi är att föredra, om det är tillämpligt.</items></items><items code="at0003"><items id="text">Datum och tid för kliniskt erkänd</items><items id="description">Uppskattat eller reellt datum coh tid som diagnosen eller problemet erkändes av sjukvårdspersonal.</items><items id="comment">Partiella datum är acceptabla. Om patienten är under ett år, då är det fullständiga datumet eller ett minimum av månad och år nödvändigt för korrekta åldersberäkningar exempelvis om de används för beslutsstöd. Data som registreras och importeras som "Ålder vid tidpunkten för kliniskt erkännande" ska omvandlas till ett datum med hjälp av patientens födelsedatum.</items></items><items code="at0005"><items id="text">Svårighetsgrad</items><items id="description">En bedömning av problemets eller diagnosens totala svårighetsgrad.</items><items id="comment">Om svårighetsgraden har lagts till i Problem- och diagnos-namnet via förkoordinerade koder, blir detta fält överflödigt. Obs: mer specifik gradering av svårighetsgrad kan registreras i fältet ”specifika detaljer.”</items></items><items code="at0009"><items id="text">Klinisk beskrivning</items><items id="description">En beskrivning av problemet eller diagnosen.</items><items id="comment">Används för att ge bakgrund och kontext, inklusive utveckling, episoder eller exacerbationer, framsteg och andra relevanta detaljer om problemet eller diagnosen.</items></items><items code="at0012"><items id="text">Anatomisk plats</items><items id="description">Identifiering av problemets eller diagnosens anatomiska plats.</items><items id="comment">Kodning av den anatomiska platsens namn med en terminologi är att föredra, om det är tillämpligt. Använd det här fältet för att dokumentera förkoordinerade anatomiska platser. Om kraven för att dokumentera den anatomiska platsen bestäms automatiskt av applikationen eller kräver mer komplicerad modellering som exempelvis relativa platser, använd i så fall Cluster.anatomical_location eller cluster. relative_location inom "Strukturerad anatomisk plats" - fältet i denna arketyp. I detta fält är det möjligt att dokumentera kliniska scenarier som exempelvis att beskriva ett utslag på flera platser, men där alla andra egenskaper är identiska. Om den anatomiska platsen ingår i problem-och diagnos-namnet via förkoordinerade koder, blir detta fält överflödigt.</items></items><items code="at0030"><items id="text">Datum och tid för upplösning</items><items id="description">Uppskattat eller reellt datum och tid för upplösning eller remission av detta problem eller diagnos, som fastställts av sjukvårdspersonal.</items><items id="comment">Partiella datum är acceptabla. Om patienten är under ett år är det fullständiga datumet eller ett minimum av månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Data som registreras och importeras som "Ålder vid tidpunkten för upplösning" ska konverteras till ett datum med hjälp av patientens födelsedatum.</items></items><items code="at0032"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0039"><items id="text">Strukturerad anatomisk plats</items><items id="description">En strukturerad anatomisk plats för problemet eller diagnosen.</items><items id="comment">Använd det här fältet för att infoga CLUSTER.anatomical_location eller CLUSTER.relative_location-arketyper om den anatomiska platsen bestäms automatiskt av applikationen eller kräver mer komplicerad modellering som exempelvis relativa platser. Om den anatomiska platsen är inkluderad i problem- och diagnos-namnet via förkoordinerade koder, blir detta fält överflödigt.</items></items><items code="at0043"><items id="text">Specifika detaljer</items><items id="description">Detaljer som krävs för att kunna dokumenteras som unika egenskaper i den här problem eller diagnos arketypen.</items><items id="comment">Fältet kan innehålla strukturerad detalj om klassificering eller stadieindelning av diagnosen diagnostiska kriterier, klassificeringskriterier eller formella bedömningar av svårighetsgrad, såsom gemensamma terminologikriterier för biverkningar.</items></items><items code="at0046"><items id="text">Status</items><items id="description">Strukturerade detaljer för plats-, domän-, episod-eller arbetsflödes specifika aspekter av diagnosprocessen.</items><items id="comment">Använd status- eller kontextbestämningar med omsorg, pga. varierande användning i praktiken samt pga. att driftskompabilitet inte kan garanteras om inte användningen är tydligt definierad i gruppen exempelvis:&#13;
Status: Aktiv och inaktiv, utredd och i remission Utvecklingsstatus: Initial, interimistisk preliminär och slutlig&#13;
Temporal status: Nuvarande och tidigare &#13;
Episodicitet status: Första, nytt och pågående&#13;
Inskrivningsstatus: Inskrivning och utskrivning Prioritetsstatus: Primär och sekundär.</items></items><items code="at0047"><items id="text">Mild</items><items id="description">Problemet eller diagnosen stör inte normal aktivitet eller kan orsaka hälsoskador om den lämnas obehandlad.</items></items><items code="at0048"><items id="text">Medel</items><items id="description">Problemet eller diagnosen orsakar störningar i normal aktivitet eller kommer att skada hälsan om den lämnas obehandlad.</items></items><items code="at0049"><items id="text">Svår</items><items id="description">Problemet eller diagnosen förhindrar normal aktivitet eller allvarligt kommer att skada hälsan om den lämnas obehandlad.</items></items><items code="at0069"><items id="text">Kommentar</items><items id="description">En extra beskrivning av problemet eller diagnosen som inte tagits upp i andra fält.</items></items><items code="at0070"><items id="text">Senast uppdaterad</items><items id="description">Datumet då problemet eller diagnosen senast uppdaterades.</items></items><items code="at0071"><items id="text">Extra information</items><items id="description">Ytterligare uppgifter som krävs för att fånga lokalt innehåll eller för anpassning till andra referens modeller och formalismer.</items><items id="comment">Exempelvis: lokala informationskrav eller ytterligare metadata för anpassning till FHIR-eller CIMI -motsvarigheter.</items></items><items code="at0072"><items id="text">Förlopp</items><items id="description">Beskrivning av problemets eller diagnosen förlopp sedan debuten.</items></items><items code="at0073"><items id="text">Diagnostisk säkerhet</items><items id="description">Säkerhetsgraden för identifiering av diagnos.</items><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items></items><items code="at0074"><items id="text">Misstänkt</items><items id="description">Diagnosen har identifierats med en låg grad av säkerhet.</items></items><items code="at0075"><items id="text">Sannolik</items><items id="description">Diagnosen har identifierats med en hög grad av säkerhet.</items></items><items code="at0076"><items id="text">Bekräftad</items><items id="description">Diagnosen har bekräftats mot kända kriterier.</items></items><items code="at0077"><items id="text">Datum och tid för debut</items><items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.</items><items id="comment">Data som dokumenteras och importeras som "Ålder vid debut" ska konverteras till ett datum med hjälp av patientens födelsedatum.</items></items><items code="at0078"><items id="text">*Cause (en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.blood_pressure.v2"><term_definitions language="de"><items code="at0000"><items id="text">Blutdruck</items><items id="description">Die lokale Messung des arteriellen Blutdrucks als Surrogat für den arteriellen Druck in der systemischen Zirkulation.</items><items id="comment">Häufig wird der Ausdruck 'Blutdruck' zur Bezeichung der Messung des brachialen Ateriendrucks im Oberarm verwendet.</items></items><items code="at0001"><items id="text">Historie</items><items id="description">Historie</items></items><items code="at0003"><items id="text">Blutdruck</items><items id="description">@ internal @</items></items><items code="at0004"><items id="text">Systolisch</items><items id="description">Der höchste arterielle Blutdruck eines Zyklus - gemessen in der systolischen oder Kontraktionsphase des Herzens.</items></items><items code="at0005"><items id="text">Diastolisch</items><items id="description">Der minimale systemische arterielle Blutdruck eines Zyklus - gemessen in der diastolischen oder Entspannungsphase des Herzens.</items></items><items code="at0006"><items id="text">Beliebiges Ereignis</items><items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items></items><items code="at0007"><items id="text">state structure</items><items id="description">@ internal @</items></items><items code="at0008"><items id="text">Position</items><items id="description">Die Position der untersuchten Person während der Messung.</items></items><items code="at0011"><items id="text">Listenstruktur</items><items id="description">Listenstruktur</items></items><items code="at0013"><items id="text">Manschettengröße</items><items id="description">Die Größe der Manschette, die zur Blutdruckmessung benutzt wurde.</items><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items></items><items code="at0014"><items id="text">Stelle der Messung</items><items id="description">Einfache Körperstelle an der der Blutdruck gemessen wurde.</items></items><items code="at0015"><items id="text">Oberschenkel eines Erwachsenen</items><items id="description">Eine Manschette für den Oberschenkel eines Erwachsenen - ca. 20cm x 42cm.</items></items><items code="at0016"><items id="text">Großer Erwachsener</items><items id="description">Eine Manschette für Erwachsene mit größeren Armen - ca. 16cm x 38cm.</items></items><items code="at0017"><items id="text">Erwachsener</items><items id="description">Eine Standard-Manschette für einen Erwachsenen - ca. 13cm x 30cm.</items></items><items code="at0025"><items id="text">Rechter Arm</items><items id="description">Der rechte Arm der Person.</items></items><items code="at0026"><items id="text">Linker Arm</items><items id="description">Der linke Arm der Person.</items></items><items code="at0027"><items id="text">Rechter Oberschenkel</items><items id="description">Der rechte Oberschenkel der Person.</items></items><items code="at0028"><items id="text">Linker Oberschenkel</items><items id="description">Der linke Oberschenkel der Person.</items></items><items code="at0033"><items id="text">Kommentar</items><items id="description">Zusätzlicher Freitext über die Messung, der nicht in anderen Felder erfasst werden konnte.</items></items><items code="at1000"><items id="text">Stehend</items><items id="description">Stehend zum Zeitpunkt der Blutdruckmessung.</items></items><items code="at1001"><items id="text">Sitzend</items><items id="description">Sitzend zum Zeitpunkt der Blutdruckmessung (z.B. auf einem Bett oder Stuhl).</items></items><items code="at1002"><items id="text">Zurückgelehnt</items><items id="description">Patient zurückgelehnt zum Zeitpunkt der Blutdruckmessung.</items></items><items code="at1003"><items id="text">Liegend</items><items id="description">Flach liegend zum Zeitpunkt der Blutdruckmessung.</items></items><items code="at1005"><items id="text">Neigung</items><items id="description">Die kraniokaudale Neigung der Oberfläche auf der die Person zum Zeitpunkt der Messung liegt.</items></items><items code="at1006"><items id="text">Mittlerer arterieller Druck</items><items id="description">Der mittlerer arterielle Druck über den gesamten Verlauf der Konktraktions- und Entspannungsphase des Herzens.</items></items><items code="at1007"><items id="text">Pulsdruck</items><items id="description">Der Abstand zwischen dem systolischen und dem diastolischen Blutdruckwert.</items></items><items code="at1008"><items id="text">Kleiner Erwachsener</items><items id="description">Eine Manschette für einen kleinen Erwachsenen - ca. 10cm x 24cm.</items></items><items code="at1009"><items id="text">Pädiatrisch/Kind</items><items id="description">Eine Manschette für ein Kind oder auch einen Erwachsenen mit einem schmalen Arm - 8cm x 21cm.</items></items><items code="at1010"><items id="text">Diastolischer Endpunkt</items><items id="description">Dient der Dokumentation des Korotkoff-Geräusches, das verwendet wird, um bei auskultarischer Messung den diastolischen Blutdruck zu bestimmen.</items></items><items code="at1011"><items id="text">Phase IV</items><items id="description">Das 4. Korotkoff-Geräusch - Die Geräusche klingen plätzlich gedämpft.</items></items><items code="at1012"><items id="text">Phase V</items><items id="description">Das 5. Korotkoff-Geräusch - die Geräusche verschwinden völlig während der Manschettendruck unter den diastolischen Blutdruck fällt.</items></items><items code="at1014"><items id="text">Nach links geneigt liegend</items><items id="description">Flach liegend mit seitlicher Neigung, normalerweise zur linken Seite. Häufig verwendet im letzten Drittel eine Schwangerschaft, um aorto-cavale Kompression zu vermeiden.</items></items><items code="at1018"><items id="text">Kleinkind</items><items id="description">Eine Manschette für Kleinkinder und Säuglinge - ca. 5cm x 15cm.</items></items><items code="at1019"><items id="text">Neonatal</items><items id="description">Eine Manschette für Neugeborene mit passender Größe für die Reife und das Geburtsgewicht des Neugeborenen.</items></items><items code="at1020"><items id="text">Rechtes Handgelenk</items><items id="description">Das rechte Handgelenk der Person.</items></items><items code="at1021"><items id="text">Linkes Handgelenk</items><items id="description">Das linke Handgelenk der Person.</items></items><items code="at1025"><items id="text">Gerät</items><items id="description">Details über das Sphygmomanometer oder ein anderes Gerät, dass zur Blutdruckmessung verwendet wird.</items></items><items code="at1026"><items id="text">Rechtes Fußgelenk</items><items id="description">Das rechte Fußgelenk der Person.</items></items><items code="at1030"><items id="text">Anstrengung</items><items id="description">Details über physische Aktivitäten zur Zeit der Blutdruckmessung.</items></items><items code="at1031"><items id="text">Linkes Fußgelenk</items><items id="description">Das linke Fußgelenk der Person</items></items><items code="at1032"><items id="text">Finger</items><items id="description">Ein Finger des Individuums.</items></items><items code="at1035"><items id="text">Methode</items><items id="description">Methode der Messung des Blutdrucks.</items></items><items code="at1036"><items id="text">Auskultation</items><items id="description">Auskulatorische Messung unter Benutzung eines Stethoskops und der Korotkoff-Geräusche.</items></items><items code="at1037"><items id="text">Palpation</items><items id="description">Palpatorische Messung, normalerweise an den brachialen oder radialen Arterien.</items></items><items code="at1038"><items id="text">Formel für mittleren arterieller Druck</items><items id="description">Die Formel die ggf. verwendet wurde, um den mittleren arteriellen Druck zu berechnen.</items></items><items code="at1039"><items id="text">Machine</items><items id="description">Messung durch eine Blutdruckmaschine.</items></items><items code="at1040"><items id="text">Invasiv</items><items id="description">Invasive Messung des Blutdrucks innerhalb eines Gefäßes.</items></items><items code="at1042"><items id="text">24 Stunden Durchschnitt</items><items id="description">Schätzung des durchschnittlichen Blutdrucks über einen 24-stündigen Zeitraum.</items></items><items code="at1043"><items id="text">Schlafzustand</items><items id="description">Schlafzustand - unterstützt die Auswertung von 24-stündigen ambulanten Aufzeichnungen des Blutdrucks.</items></items><items code="at1044"><items id="text">Aufmerksam und wach</items><items id="description">Die untersuchte Person ist bei vollem Bewusstsein.</items></items><items code="at1045"><items id="text">Schlafend</items><items id="description">Die untersuchte Person schläft.</items></items><items code="at1051"><items id="text">Zeh</items><items id="description">Ein Zeh des Individuums.</items></items><items code="at1052"><items id="text">Einflussfaktoren</items><items id="description">Kommentar und Aufzeichung anderer Faktoren die ggf. zu dem Ergebnis der Blutdruckmessung beitragen können. Die kann z.B. bei belastenden Situationen der Fall sein (z.B. sog. Weißkittelhypertonie, Schmerzen, Fieber, Änderungen im atmosphärischen Druck).</items></items><items code="at1053"><items id="text">Intraarteriell</items><items id="description">Invasive Messung mittels Transducer über einen arteriellen Zugang.</items></items><items code="at1054"><items id="text">Formel für systolischen Druck</items><items id="description">Formel, die benutzt wurde, um den systolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items></items><items code="at1055"><items id="text">Formel für diastolischen Druck</items><items id="description">Formel, die benutzt wurde, um den distolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items></items><items code="at1056"><items id="text">Fußrücken</items><items id="description">Fußrücken des Individuums.</items></items><items code="at1057"><items id="text">Strukturierte Stelle der Messung</items><items id="description">Strukturierte Körperstelle an der der Blutdruck gemessen wurde.</items></items><items code="at1058"><items id="text">Erweiterung</items><items id="description">Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.</items><items id="comment">Zum Beispiel: Informationen bzgl. der lokalen Krankenhausabteilung oder zusätzliche Metadata zur Anpassung an entsprechende FHIR oder CIMI Gegenstücke.</items></items><items code="at1059"><items id="text">Klinische Interpretation</items><items id="description">Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der Blutdruckmessung.</items></items><items code="mm[Hg]"><items id="text">mmHg</items><items id="description">millimeters of mercury</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Blodtryck</items><items id="description">Den lokala mätningen av artärblodtrycket som är ett surrogat för artärtryck i systemcirkulationen. Vanligtvis refererar användningen av termen blodtryck till mätningen av brakialartärtrycket i överarmen.</items><items id="comment">*Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.(en)</items></items><items code="at0001"><items id="text">Anamnes</items><items id="description">Strukturnod anamnes.</items></items><items code="at0003"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0004"><items id="text">Systoliskt</items><items id="description">Det högsta systemiskt arteriella blodtrycket uppmätt systoliskt eller under sammandragningsfasen av hjärtcykeln.</items></items><items code="at0005"><items id="text">Diastoliskt</items><items id="description">Det minsta systemiskt arteriella blodtrycket uppmätt diastoliskt eller i hjärtcykelns avslappningsfas.</items></items><items code="at0006"><items id="text">Ospecificerad händelse</items><items id="description">Standardval, händelse i ospecificerad tidpunkt eller tidsintervall som explicit kan definieras i en mall eller vid körning av program.</items></items><items code="at0007"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0008"><items id="text">Ställning</items><items id="description">Individens kroppsställning under mätningen.</items></items><items code="at0011"><items id="text">Träd</items><items id="description">Liststruktur</items></items><items code="at0013"><items id="text">Manschettstorlek</items><items id="description">Storleken på manschetten som används för blodtrycksmätning.</items><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items></items><items code="at0014"><items id="text">Mätplats</items><items id="description">Beskrivning av anatomiskt plats där blodtrycket mäts.</items></items><items code="at0015"><items id="text">Vuxet lår</items><items id="description">En lårmanschett för vuxna.</items></items><items code="at0016"><items id="text">Stor vuxen</items><items id="description">En manschett för vuxna med större armar.</items></items><items code="at0017"><items id="text">Vuxen</items><items id="description">En standardmanschett för vuxna.</items></items><items code="at0025"><items id="text">Höger arm</items><items id="description">Individens högra arm.</items></items><items code="at0026"><items id="text">Vänster arm</items><items id="description">Individens vänstra arm.</items></items><items code="at0027"><items id="text">Höger lår</items><items id="description">Individens högra lår.</items></items><items code="at0028"><items id="text">Vänster lår</items><items id="description">Individens vänstra lår.</items></items><items code="at0033"><items id="text">Kommentar</items><items id="description">Ytterligare beskrivning av mätningen som inte beskrivits i andra fält.</items></items><items code="at1000"><items id="text">Stående</items><items id="description">Stående ställning under blodtrycksmätningen</items></items><items code="at1001"><items id="text">Sittande</items><items id="description">Sittande ställning under blodtrycksmätningen, exempelvis på en säng eller stol.</items></items><items code="at1002"><items id="text">Halvliggande</items><items id="description">Halvliggande ställning under blodtrycksmätningen.</items></items><items code="at1003"><items id="text">Liggande</items><items id="description">Liggande ställning under blodtrycksmätningen.</items></items><items code="at1005"><items id="text">Lutning</items><items id="description">Lutning på ytan av huvuddelen som personen ligger på vid tidpunkten för mätningen.</items><items id="comment">OBS: '°' är en giltig UCUM-enhet. Använd "deg" som den rätta enheten.</items></items><items code="at1006"><items id="text">Medelartärtryck</items><items id="description">Det genomsnittliga artärtrycket som inträffar under hela hjärtsammandragningen och under avslappningscykeln.</items></items><items code="at1007"><items id="text">Pulstryck</items><items id="description">Skillnaden mellan systoliskt och diastoliskt blodtryck.</items></items><items code="at1008"><items id="text">Liten Vuxen</items><items id="description">En manschett som används till små vuxna.</items></items><items code="at1009"><items id="text">Pediatrisk/Barn</items><items id="description">En manschett som passar barn eller vuxna med smala armar.</items></items><items code="at1010"><items id="text">Diastoliskt effektmått</items><items id="description">Registrerat Korotkoff-ljud som används för att avgöra diastoliskt tryck med hjälp av auskultatorisk metod.</items></items><items code="at1011"><items id="text">Fas IV</items><items id="description">Det fjärde Korotkoff-ljudet identifieras som en plötslig ljuddämpning.</items></items><items code="at1012"><items id="text">Fas V</items><items id="description">Det femte Korotkoff-ljudet identifieras genom avsaknad av ljud då manschettrycket sjunker under det diastoliska blodtrycket.</items></items><items code="at1014"><items id="text">Liggande med lutning till vänster</items><items id="description">Liggande i platt ställning med viss lateral lutning, vanligtvis mot vänster sida. Den krävs vanligtvis i graviditetens sista trimester för att lindra aortokaval kompression.</items></items><items code="at1018"><items id="text">Spädbarn</items><items id="description">En manschett för spädbarn.</items></items><items code="at1019"><items id="text">Nyfödd</items><items id="description">En manschett som används på nyfödda, om manschetten anses vara av lämplig storlek till den nyföddas mognads- och födelsevikt.</items></items><items code="at1020"><items id="text">Höger handled</items><items id="description">Individens högra handled.</items></items><items code="at1021"><items id="text">Vänster handled</items><items id="description">Individens vänstra handled.</items></items><items code="at1025"><items id="text">Utrustning</items><items id="description">Detaljer om blodtrycksmätaren eller annan apparat som används för att mäta blodtrycket.</items></items><items code="at1026"><items id="text">Höger vrist</items><items id="description">Individens högra vrist.</items></items><items code="at1030"><items id="text">Ansträngning</items><items id="description">Detaljer om den fysiska aktiviteten som utförts vid tidpunkten av blodtrycksmätningen.</items></items><items code="at1031"><items id="text">Vänster vrist</items><items id="description">Individens vänstra vrist.</items></items><items code="at1032"><items id="text">Finger</items><items id="description">Individens finger.</items></items><items code="at1035"><items id="text">Metod</items><items id="description">Metod för mätning av blodtryck.</items></items><items code="at1036"><items id="text">Auskultation</items><items id="description">Metod för extern mätning av blodtryck med hjälp av stetoskop och Korotkoff-ljud.</items></items><items code="at1037"><items id="text">Palpation</items><items id="description">Metod för att mäta blodtrycket externt med hjälp av palpation, vanligtvis av brakiala eller radiella artärer.</items></items><items code="at1038"><items id="text">Formel för medelartärtryck</items><items id="description">Formel som används för att beräkna medelartärtrycket (om det finns registrerat).</items></items><items code="at1039"><items id="text">Blodtrycksmaskin</items><items id="description">Metod för mätning av blodtryck externt med hjälp av en blodtrycksmaskin.</items></items><items code="at1040"><items id="text">Invasiv</items><items id="description">Metod för att mäta blodtrycket intravenöst dvs. genom att penetrera huden och mäta inuti blodkärlen.</items></items><items code="at1042"><items id="text">24 timmars blodtrycksmätning</items><items id="description">Beräkning av det genomsnittliga blodtrycket under en 24-timmarsperiod.</items></items><items code="at1043"><items id="text">Vakenhet</items><items id="description">Vakenhet som stöder tolkningen av 24-timmars ambulatoriska blodtrycksmätningar.</items></items><items code="at1044"><items id="text">Alert och vaken</items><items id="description">Patienten är vid fullt medvetande.</items></items><items code="at1045"><items id="text">Sover</items><items id="description">Patienten är i det naturliga tillståndet av kroppslig vila.</items></items><items code="at1051"><items id="text">Tå</items><items id="description">Individens tå.</items></items><items code="at1052"><items id="text">Möjliga felkällor</items><items id="description">Andra faktorer som kan påverka blodtrycksmätningen, exempelvis ångestnivå, "vitrockseffekt", smärta, feber eller förändringar i lufttryck mm.</items></items><items code="at1053"><items id="text">Intraarteriell</items><items id="description">Invasiv mätning via transduktoråtkomstlinjen inom en artär.</items></items><items code="at1054"><items id="text">Formel för systoliskt tryck</items><items id="description">Formel som används för att beräkna det systoliska trycket från medelartärtrycket (om det finns registrerat).</items></items><items code="at1055"><items id="text">Formel för diastoliskt tryck</items><items id="description">Formel som används för att beräkna det diastoliska trycket från medelartärtrycket (om det finns registrerat).</items></items><items code="at1056"><items id="text">Fotryggen</items><items id="description">Individens fotrygg.</items></items><items code="at1057"><items id="text">Strukturerad mätplats</items><items id="description">Strukturerad anatomisk plats där mätningen gjordes.</items></items><items code="at1058"><items id="text">Extra information</items><items id="description">Ytterligare information som krävs för att fånga lokal kontext eller för anpassning till andra referensmodeller och formalismer.</items><items id="comment">Exempelvis uppgifter om en lokal sjukhusavdelning eller ytterligare metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items></items><items code="at1059"><items id="text">Klinisk tolkning</items><items id="description">Ord, fras eller kort beskrivning som representerar den kliniska betydelsen och signifikansen av blodtrycksmätningen.</items></items><items code="mm[Hg]"><items id="text">mmHg</items><items id="description">millimeters of mercury</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_temperature.v2"><term_definitions language="de"><items code="at0000"><items id="text">Körpertemperatur</items><items id="description">Eine Messung der Körpertemperatur, als Surrogat für die Temperatur des gesamten Körper der Person.</items></items><items code="at0001"><items id="text">Single</items><items id="description">*</items></items><items code="at0002"><items id="text">History</items><items id="description">@ internal @</items></items><items code="at0003"><items id="text">Beliebiges Ereignis</items><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items></items><items code="at0004"><items id="text">Temperatur</items><items id="description">Die gemessene Körpertemperatur.</items></items><items code="at0020"><items id="text">Protocol</items><items id="description">@ internal @</items></items><items code="at0021"><items id="text">Lokalisation der Messung</items><items id="description">Einfache Beschreibung der Stelle der Messung.</items></items><items code="at0022"><items id="text">Mund</items><items id="description">Messung der Temperatur im Mund.</items></items><items code="at0023"><items id="text">Ohrkanal</items><items id="description">Messung der Temperatur innerhalb des äußeren Gehörgangs.</items></items><items code="at0024"><items id="text">Achselhöhle</items><items id="description">Messung der Temperatur an der Haut der Achselhöhle mit seitlich angelegtem Arm.</items></items><items code="at0025"><items id="text">Rektum</items><items id="description">Messung der Temperatur innerhalb des Rektums.</items></items><items code="at0026"><items id="text">Nasopharynx</items><items id="description">Messung der Temperatur innerhalb des Nasopharynxs (Nasenrachens).</items></items><items code="at0027"><items id="text">Harnblase</items><items id="description">Messung der Temperatur in der Harnblase.</items></items><items code="at0028"><items id="text">Intravaskulär</items><items id="description">Messung der Temperatur innerhalb des vaskulären Systems.</items></items><items code="at0029"><items id="text">Status</items><items id="description">Statusinformationen über den Patienten.</items></items><items code="at0030"><items id="text">Körperexposition</items><items id="description">Der Expositionsgrad der Person, deren Temperatur gemessen wird.</items></items><items code="at0031"><items id="text">Nackt</items><items id="description">Keine Kleidung, Bettzeug oder andere Bedeckung.</items></items><items code="at0032"><items id="text">Reduzierte Kleidung/Bettzeug</items><items id="description">Die Person wird bedeckt von einer geringeren Menge an Kleidung oder Bettzeug als für die Umgebungsbedingungen angemessen erscheint.</items></items><items code="at0033"><items id="text">Angemessene Kleidung/Bettzeug</items><items id="description">Die Person wird bedeckt von einer Menge an Kleidung oder Bettzeug, die den Umgebungsbedingungen angemessen erscheint.</items></items><items code="at0034"><items id="text">Erhöhte Kleidung/Bettzeug</items><items id="description">Die Person wird bedeckt von einer größeren Menge an Kleidung oder Bettzeug als für die Umgebungsbedingungen angemessen erscheint.</items></items><items code="at0041"><items id="text">Beschreibung der Wärmebelastung</items><items id="description">Beschreibung von Bedingungen, denen die Person ausgesetzt ist, welche die gemessene Körpertemperatur beeinflussen könnten.</items></items><items code="at0043"><items id="text">Haut</items><items id="description">Messung der Temperatur an freiliegender Haut.</items></items><items code="at0051"><items id="text">Vagina</items><items id="description">Messung der Temperatur innerhalb der Vagina.</items></items><items code="at0054"><items id="text">Oesophagus</items><items id="description">Messung der Temperatur innerhalb des Oesophagus.</items></items><items code="at0055"><items id="text">Inguinale Hautfalte</items><items id="description">Messung der Temperatur in der inguinalen Hautfalte zwischen Bein und Abdominalwand.</items></items><items code="at0056"><items id="text">Umgebungsbedingungen</items><items id="description">Details über die Umgebungsbedingungen zum Zeitpunkt der Temperaturmessung</items></items><items code="at0057"><items id="text">Betätigung</items><items id="description">Details über die Betätigung der Person zum Zeitpunkt der Messung der Temperatur.</items></items><items code="at0059"><items id="text">Gerät</items><items id="description">Details über das Gerät, das zur Temperaturmessung benutzt wurde.</items></items><items code="at0060"><items id="text">Schläfe</items><items id="description">Messung der Temperatur an der Schläfe, über der oberflächlichen Schläfenarterie.</items></items><items code="at0061"><items id="text">Stirn</items><items id="description">Messung der Temperatur auf der Stirn.</items></items><items code="at0062"><items id="text">Erweiterung</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen.</items></items><items code="at0063"><items id="text">Kommentar</items><items id="description">Zusätzliche Informationen über die Körpertemperatur, die nicht in anderen Bereichen dargestellt wurden.</items></items><items code="at0064"><items id="text">Strukturierte Lokalisation der Messung</items><items id="description">Strukturierte anatomische Lokalisation, an dem die Messung vorgenommen wurde.</items></items><items code="at0065"><items id="text">Tag des Menstruationszyklus</items><items id="description">Aktueller Tag des Menstruationszyklus.</items><items id="comment">Der erste Tag der Menstruation gilt als Tag 1 jedes Menstruationszyklus.</items></items><items code="at0066"><items id="text">Störfaktoren</items><items id="description">Zusätzliche Probleme oder Faktoren, die sich auf die Messung der Körpertemperatur auswirken können und in anderen Bereichen nicht dargestellt werden.</items></items><items code="Cel"><items id="text">°C</items><items id="description">degrees Celsius</items></items><items code="[degF]"><items id="text">°F</items><items id="description">degrees Fahrenheit</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Kroppstemperatur</items><items id="description">Mätning av kroppstemperaturen, som är ett surrogat för individens kärntemperatur.</items></items><items code="at0001"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">History</items><items id="description">@ internal @</items></items><items code="at0003"><items id="text">Ospecificerad händelse</items><items id="description">Standard, ospecificerad händelse vid en tidpunkt eller ett tidsintervall som explicit kan definieras i en mall eller vid körning av program.</items></items><items code="at0004"><items id="text">Temperatur</items><items id="description">*The measured temperature. (en)</items></items><items code="at0020"><items id="text">Protocol</items><items id="description">@ internal @</items></items><items code="at0021"><items id="text">Mätplats</items><items id="description">*Simple description about the site of measurement. (en)</items></items><items code="at0022"><items id="text">Mun</items><items id="description">Temperaturen mäts i munnen.</items></items><items code="at0023"><items id="text">Hörselgång</items><items id="description">Temperaturen mäts inifrån den externa hörselgången.</items></items><items code="at0024"><items id="text">Axill</items><items id="description">Temperaturen mäts på armens hud, med armen placerad nedåt vid sidan.</items></items><items code="at0025"><items id="text">Rektum</items><items id="description">Temperaturen mäts i ändtarmen.</items></items><items code="at0026"><items id="text">Nasofarynx</items><items id="description">Temperaturen mäts i nasofarynxen.</items></items><items code="at0027"><items id="text">Urinblåsa</items><items id="description">Temperaturen mäts i urinblåsan.</items></items><items code="at0028"><items id="text">Intravaskulär</items><items id="description">Temperaturen mäts i kärlsystemet.</items></items><items code="at0029"><items id="text">Status</items><items id="description">Information om individens tillstånd.</items></items><items code="at0030"><items id="text">Kroppsexponering</items><items id="description">Individens kroppsexponering vid tidpunkten för mätningen.</items></items><items code="at0031"><items id="text">Naken</items><items id="description">Individen har inga kläder, sängkläder eller överdrag på sig.</items></items><items code="at0032"><items id="text">Mindre mängd kläder och sängkläder</items><items id="description">Individen är täckt av en mindre mängd kläder eller sängkläder än vad som bedöms vara lämpliga för miljöförhållandena.</items></items><items code="at0033"><items id="text">Lämplig mängd kläder och sängkläder</items><items id="description">Individen är täckt av en mängd kläder eller sängkläder som bedöms vara lämpliga för miljöförhållandena.</items></items><items code="at0034"><items id="text">Större mängd kläder och sängkläder</items><items id="description">Individen är täckt av en större mängd kläder eller sängkläder än vad som bedöms vara lämpliga för miljöförhållandena.</items></items><items code="at0041"><items id="text">Beskrivning av termisk stress</items><items id="description">*Narrative description of the conditions applied to the subject that might influence their measured body temperature. (en)</items></items><items code="at0043"><items id="text">Hud</items><items id="description">Temperaturen mäts från exponerad hud.</items></items><items code="at0051"><items id="text">Vagina</items><items id="description">Temperaturen mäts i vaginan.</items></items><items code="at0054"><items id="text">Esofagus</items><items id="description">Temperaturen mäts i matstrupen.</items></items><items code="at0055"><items id="text">Ljumskveck</items><items id="description">Temperaturen mäts i ljumskens hudveck mellan benet och bukväggen.</items></items><items code="at0056"><items id="text">Miljöförhållanden</items><items id="description">Information om rådande miljöförhållanden vid tidpunkten för temperaturmätning.</items></items><items code="at0057"><items id="text">Ansträngning</items><items id="description">Uppgifter om individens ansträngning vid tidpunkten för temperaturmätning.</items></items><items code="at0059"><items id="text">Utrustning</items><items id="description">*Details about the device used to measure body temperature. (en)</items></items><items code="at0060"><items id="text">Tinning</items><items id="description">Temperaturen mäts på tinningen, över den ytliga temporalartären.</items></items><items code="at0061"><items id="text">Panna</items><items id="description">Temperaturen mäts på pannan.</items></items><items code="at0062"><items id="text">Extra information</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items></items><items code="at0063"><items id="text">Kommentar</items><items id="description">Extra kommentar om kroppstemperaturen som inte beskrivits i andra fält.</items></items><items code="at0064"><items id="text">Strukturerad mätplats</items><items id="description">*Structured details about the location of measurement. (en)</items></items><items code="at0065"><items id="text">Dag i menstruationscykeln</items><items id="description">*Current day of the menstrual cycle.(en)</items><items id="comment">*The first day of menstruation is considered to be Day 1 of each menstrual cycle. (en)</items></items><items code="at0066"><items id="text">*Confounding factors(en)</items><items id="description">*Additional issues or factors that may impact on the measurement of body temperature, not captured in other fields. (en)</items></items><items code="Cel"><items id="text">°C</items><items id="description">degrees Celsius</items></items><items code="[degF]"><items id="text">°F</items><items id="description">degrees Fahrenheit</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_weight.v2"><term_definitions language="de"><items code="at0000"><items id="text">Körpergewicht</items><items id="description">Messung des Körpergewichts eines Individuums.</items></items><items code="at0001"><items id="text">Simple</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">History</items><items id="description">@ internal @</items></items><items code="at0003"><items id="text">Beliebiges Ereignis</items><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items></items><items code="at0004"><items id="text">Gewicht</items><items id="description">Das Gewicht eines Individuums.</items></items><items code="at0008"><items id="text">State structure</items><items id="description">@ internal @</items></items><items code="at0009"><items id="text">Status der Bekleidung</items><items id="description">Beschreibung des Kleidungszustands der Person zum Zeitpunkt des Wiegens.</items></items><items code="at0010"><items id="text">Voll bekleidet, mit Schuhen</items><items id="description">Bekleidung, die signifikant zum Gewicht beiträgt, mit Schuhen.</items></items><items code="at0011"><items id="text">Leicht bekleidet / Unterwäsche</items><items id="description">Bekleidung, die nicht signifikant zum Gewicht beiträgt.</items></items><items code="at0013"><items id="text">Unbekleidet</items><items id="description">Ohne Kleidung.</items></items><items code="at0015"><items id="text">Protocol structure</items><items id="description">@ internal @</items></items><items code="at0017"><items id="text">Windel</items><items id="description">Trägt Windel; kann signifikant zum Gewicht beitragen.</items></items><items code="at0020"><items id="text">Gerät</items><items id="description">Details über die benutzte Waage.</items></items><items code="at0024"><items id="text">Kommentar</items><items id="description">Zusätzliche Darstellung der Messung des Körpergewichts, die in anderen Bereichen nicht erfasst wurde.&#13;
	</items></items><items code="at0025"><items id="text">Einflußfaktoren</items><items id="description">Beschreibung aller Probleme oder Faktoren, die sich auf die Messung des Körpergewichts auswirken können, z. B. das Timing im Menstruationszyklus, das Timing des letzten Stuhlgangs oder das Feststellen einer Amputation.</items></items><items code="at0026"><items id="text">Geburt</items><items id="description">Normalerweise das erste Gewicht, gemessen kurz nach der Geburt. Dieses Ereignis wird nur einmal pro Gesundheitsakte verwendet.</items></items><items code="at0027"><items id="text">Erweiterung</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items></items><items code="at0028"><items id="text">Voll bekleidet, ohne Schuhen</items><items id="description">Bekleidung, die signifikant zum Gewicht beiträgt.</items></items><items code="[lb_av]"><items id="text">lbm</items><items id="description">pound mass</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Kroppsvikt</items><items id="description">Mätning av en individs kroppsvikt.</items></items><items code="at0001"><items id="text">Simple</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">history</items><items id="description">@ internal @</items></items><items code="at0003"><items id="text">Ospecificerad händelse</items><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items></items><items code="at0004"><items id="text">Vikt</items><items id="description">Individens vikt.</items></items><items code="at0008"><items id="text">state structure</items><items id="description">@ internal @</items></items><items code="at0009"><items id="text">Klädsel</items><items id="description">Beskrivning av individens klädsel vid tidpunkten för vägning.</items></items><items code="at0010"><items id="text">Fullt påklädd, inklusive skor</items><items id="description">Kläder, inklusive skor, som kan addera vikt avsevärt.</items></items><items code="at0011"><items id="text">Lätt klädd/underkläder</items><items id="description">Kläder som inte adderar vikt avsevärt.</items></items><items code="at0013"><items id="text">Naken</items><items id="description">Inga kläder alls.</items></items><items code="at0015"><items id="text">protocol structure</items><items id="description">@ internal @</items></items><items code="at0017"><items id="text">Blöja</items><items id="description">Iklädd endast blöja, som kan addera vikt avsevärt.</items></items><items code="at0020"><items id="text">Utrustning</items><items id="description">Detaljer om den utrustning som används för att mäta vikten.</items></items><items code="at0024"><items id="text">Kommentar</items><items id="description">Kommentarer avseende mätningen av kroppsvikt, som inte beskrivs i övriga fält.</items></items><items code="at0025"><items id="text">Möjliga felkällor</items><items id="description">Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppsvikt, exempelvis tidpunkt i menstruationscykeln, tid sedan senaste tarmrörelse, eller amputation.</items></items><items code="at0026"><items id="text">Födelse</items><items id="description">Vanligtvis den första vägningen, strax efter födseln. Den här händelsen registeras endast en gång per patientjournal.</items></items><items code="at0027"><items id="text">Tilläggsinformation</items><items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items></items><items code="at0028"><items id="text">*Fully clothed, without shoes (en)</items><items id="description">*Clothing which may add significantly to weight. (en)</items></items><items code="[lb_av]"><items id="text">lbm</items><items id="description">pound mass</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.height.v2"><term_definitions language="de"><items code="at0000"><items id="text">Größe/Länge</items><items id="description">Größe bzw. Körperlänge wird vom Scheitel bis zur Fußsohle gemessen.</items><items id="comment">Die Größe wird bei der Person in stehender Position und die Körperlänge in liegender Position gemessen.</items></items><items code="at0001"><items id="text">History</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Beliebiges Ereignis</items><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items></items><items code="at0003"><items id="text">Simple</items><items id="description">@ internal @</items></items><items code="at0004"><items id="text">Größe/Länge</items><items id="description">Die Länge des Körpers vom Scheitel bis zur Fußsohle.</items></items><items code="at0007"><items id="text">List</items><items id="description">@ internal @</items></items><items code="at0011"><items id="text">Gerät</items><items id="description">Beschreibung des Geräts, das zur Messung der Größe oder Länge verwendet wurde.</items></items><items code="at0013"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0014"><items id="text">Position</items><items id="description">Position des Individiums bei der Messung.</items></items><items code="at0016"><items id="text">Stehend</items><items id="description">Die Größe wird auf beiden Füßen stehend gemessen, wobei das Gewicht gleichmäßig verteilt ist, die Fersen zusammen und sowohl das Gesäß als auch die Fersen in Kontakt mit einem vertikalen Rückenbrett.</items></items><items code="at0018"><items id="text">Kommentar</items><items id="description">Zusätzliche Darstellung der Messung, die in anderen Bereichen nicht erfasst wurde.</items></items><items code="at0019"><items id="text">Einflussfaktoren</items><items id="description">Beschreibung aller Probleme oder Faktoren, die sich auf die Messung auswirken können.</items><items id="comment">Zum Beispiel: Feststellung einer Amputation.</items></items><items code="at0020"><items id="text">Liegend</items><items id="description">Länge wird in einer voll ausgestreckten, liegenden Position gemessen. Hierbei wird das Becken flach gehalten, die Beine ausgestreckt und die Füße gebeugt.&#13;
</items></items><items code="at0021"><items id="text">Geburt</items><items id="description">Normalerweise wird die erste Längenmessung kurz nach der Geburt aufgezeichnet. Dieses Ereignis wird nur einmal pro Gesundheitsakte verwendet.</items></items><items code="at0022"><items id="text">Erweiterung</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items></items><items code="[in_i]"><items id="text">in</items><items id="description">inch</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Kroppslängd</items><items id="description">Kroppslängd mäts från hjässa till fotsula.</items><items id="comment">Kroppslängd mäts med individen stående eller liggande.</items></items><items code="at0001"><items id="text">history</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Händelse</items><items id="description">Händelse, där tiden anges explicit i en template eller genereras automatiskt av vissa IT-system.</items></items><items code="at0003"><items id="text">Simple</items><items id="description">@ internal @</items></items><items code="at0004"><items id="text">Kroppslängd</items><items id="description">Kroppslängd från hjässa till fotsula.</items></items><items code="at0007"><items id="text">List</items><items id="description">@ internal @</items></items><items code="at0011"><items id="text">Utrustning</items><items id="description">Beskrivning av den utrustning som används vid mätning av kroppslängd.</items></items><items code="at0013"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0014"><items id="text">Kroppsställning</items><items id="description">Individens kroppsställning vid mätning.</items></items><items code="at0016"><items id="text">Stående</items><items id="description">Kroppslängden mäts i stående ställning med jämn viktfördelning mellan fötterna, hälarna ihop, samt skinkor och hälar i kontakt med en vertikal yta.</items></items><items code="at0018"><items id="text">Kommentar</items><items id="description">Kommentarer avseende mätningen av kroppslängden som inte beskrivs i övriga fält.</items></items><items code="at0019"><items id="text">Möjliga felkällor och påverkande faktorer</items><items id="description">Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppslängd.</items><items id="comment">Exempelvis notering om amputation.</items></items><items code="at0020"><items id="text">Liggande</items><items id="description">Kroppslängden mäts i liggande helt utsträckt ställning med bäckenet platt, benen utsträckta och fötterna vinklade.</items></items><items code="at0021"><items id="text">Födelse</items><items id="description">Vanligtvis den första mätningen av barnet strax efter födseln. Den här händelsen används endast en gång per patientjournal.</items></items><items code="at0022"><items id="text">Tilläggsinformation</items><items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items></items><items code="[in_i]"><items id="text">in</items><items id="description">inch</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-CLUSTER.device.v1"><term_definitions language="de"><items code="at0000"><items id="text">Medizingerät</items><items id="description">Ein Instrument, ein Gerät, ein Implantat, ein Material oder ähnliches, das für die Bereitstellung von Gesundheitsleistungen verwendet wird. In diesem Zusammenhang umfasst ein medizinisches Gerät eine breite Palette von Geräten, die auf verschiedene physikalische, mechanische, thermische oder ähnliche Weise wirken, schließt jedoch insbesondere Geräte aus, die auf medizinischem Wege wirken, wie zum Beispiel pharmakologische, metabolische oder immunologische Methoden. Der Geltungsbereich umfasst&#13;
Einweggeräte sowie langlebige oder dauerhafte Geräte, die nachverfolgt,&#13;
gewartet oder regelmäßig kalibriert werden müssen, wobei zu berücksichtigen ist, dass für jeden Gerätetyp bestimmte Datenaufzeichnungsanforderungen gelten.</items></items><items code="at0001"><items id="text">Gerätename</items><items id="description">Identifizierung des Medizingerätes, bevorzugt durch einen allgemein&#13;
gebräuchlichen Namen, einer formellen und vollständig beschreibenden Bezeichnung oder falls notwendig anhand einer Klasse oder Kategorie des Gerätes.</items><items id="comment">Dieses Datenelement erfasst den Begriff, die Phrase oder die Kategorie, die in der klinischen Praxis verwendet werden. Zum Beispiel: &lt;Markenname&gt; &lt;Maschine&gt; (XYZ-Audiometer); &lt;Markenname&gt; (14G Jelco IV-Katheter); oder &lt;Markenname / Typ&gt; &lt;Implantat&gt;. Die Codierung mit einer Terminologie ist nach Möglichkeit wünschenswert, auch wenn dies lokal sein kann und von den verfügbaren lokalen Lieferungen abhängt.</items></items><items code="at0002"><items id="text">Beschreibung</items><items id="description">Beschreibung des Medizingerätes.</items></items><items code="at0003"><items id="text">Gerätetyp</items><items id="description">Die Kategorie des Medizingeräts.</items><items id="comment">Nicht zutreffend, wenn eine Kategorie bereits unter "Gerätename" dokumentiert ist. &#13;
Beispiel: Wenn das 'Gerät' als 'Harnkatheter' bezeichnet wird; der 'Typ' kann als 'Verweilkatheter' oder 'Kondom' aufgezeichnet werden. Die Codierung mit einer Terminologie ist wünschenswert, sofern dies möglich ist. Dies kann die Verwendung von GTIN- oder EAN-Nummern einschließen.</items></items><items code="at0004"><items id="text">Hersteller</items><items id="description">Name des Herstellers.</items></items><items code="at0005"><items id="text">Herstellungsdatum</items><items id="description">Herstellungsdatum des Gerätes.</items></items><items code="at0006"><items id="text">Chargennummer</items><items id="description">Die vom Hersteller zugewiesene Nummer, die eine Gruppe von gleichzeitig hergestellten Artikeln kennzeichnet, die sich normalerweise auf dem Etikett oder dem Verpackungsmaterial befindet.</items></items><items code="at0007"><items id="text">Ablaufdatum</items><items id="description">Das Datum, ab dem das Gerät/Produkt nicht mehr einsatzfähig ist. Wird normalerweise auf dem Gerät selbst oder auf der beiliegenden Verpackung aufgedruckt.</items><items id="comment">Dieses Datum gilt normalerweise nur für Einmalprodukte oder Einwegprodukte.</items></items><items code="at0008"><items id="text">Kommentar</items><items id="description">Informationen, die hier nicht strukturiert erfasst wurden.</items></items><items code="at0009"><items id="text">Eigenschaften</items><items id="description">Weitere Details zu bestimmten Eigenschaften des Medizingerätes.</items></items><items code="at0018"><items id="text">Komponenten</items><items id="description">Zusätzliche strukturierte Informationen zu identifizierten Komponenten des Geräts.</items></items><items code="at0019"><items id="text">Geräteverwaltung</items><items id="description">Weitere Details zur Verwaltung und Wartung des Geräts.</items><items id="comment">Zum Beispiel: Eigentümer, Kontaktdaten, Standort, Netzwerkadresse, Ersetzungsdatum, Kalibrierungsdetails usw.</items></items><items code="at0020"><items id="text">Seriennummer</items><items id="description">Die vom Hersteller zugewiesene Nummer, die sich auf dem Gerät befindet, muss für jedes Gerät, sein Etikett oder die dazugehörige Verpackung spezifisch sein.</items></items><items code="at0021"><items id="text">Eindeutige Identifikationsnummer (ID)</items><items id="description">Eine numerische oder alphanumerische Zeichenfolge, die diesem Gerät in einem bestimmten System zugeordnet ist.&#13;
&#13;
</items><items id="comment">Oft als Barcode am Gerät befestigt.</items></items><items code="at0022"><items id="text">Katalognummer</items><items id="description">Die genaue vom Hersteller vergebene Nummer, wie sie im Herstellerkatalog, in der Gerätekennzeichnung oder in der Begleitverpackung angegeben ist.</items></items><items code="at0023"><items id="text">Modellnummer</items><items id="description">Die Modellnummer des Herstellers, die sich auf dem Geräteetikett oder der zugehörigen Verpackung befindet.</items></items><items code="at0024"><items id="text">Weitere ID</items><items id="description">Nicht spezifizierter Bezeichner, der in einer Vorlage oder zur Laufzeit weiter spezifiziert werden kann.</items><items id="comment">Sofern verfügbar, ist die Kodierung des Namens des Identifikators mit einem Kodierungssystem wünschenswert.</items></items><items code="at0025"><items id="text">Softwareversion</items><items id="description">Identifizierung der im Medizingerät verwendeten Softwareversion.</items><items id="comment">Wenn das Medizinprodukt eine eigentliche Softwareanwendung ist, erfassen Sie die Version der Software mit diesem Datenelement. Wenn in dem Medizingerät mehrere Softwareanwendungen eingebettet sind, zeichnen Sie jede Softwarekomponente in einem separaten CLUSTER-Archetyp im &#13;
Komponenten-SLOT auf - entweder als verschachtelte Instanz eines&#13;
anderen CLUSTER.device-Archetyps oder unter Verwendung eines&#13;
CLUSTER-Archetyps, der speziell für die Aufzeichnung von&#13;
Softwaredetails entwickelt wurde (aber zum Zeitpunkt dieser&#13;
Archetypentwicklung noch nicht verfügbar war).</items></items><items code="at0026"><items id="text">Erweiterung</items><items id="description">Zusätzliche Informationen, die zur Erfassung des lokalen Kontexts oder&#13;
zur Angleichung an andere Referenzmodelle/Formalismen erforderlich sind.</items></items><items code="at0027"><items id="text">Multimedia</items><items id="description">Digitale Repräsentation des Gerätes.</items><items id="comment">Zum Beispiel: ein technisches Diagramm eines Geräts oder ein digitales Bild.</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Medicinsk utrustning</items><items id="description">Ett instrument, en apparat, ett implantat, ett material eller liknande, som används vid tillhandahållandet av vård.&#13;
 I detta sammanhang innefattar en medicinsk utrustning ett brett utbud av utrustningar som fungerar på fysiska, mekaniska, termiska eller liknande sätt.&#13;
I skopet finns inte de specifika utrustningar som fungerar med medicinska medel såsom farmakologiska, metaboliska eller immunologiska metoder.. &#13;
I skopen inkluderas även engångsutrustning, hållbara eller bestående utrustningar som kräver spårning, underhållsaktiviteter eller regelbunden kalibrering, man ska komma ihåg att varje typ av utrustning har specifika datainmatningskrav.</items></items><items code="at0001"><items id="text">Namn på utrustning</items><items id="description">Identifiering av den medicinska utrustningen, helst med ett gemensamt namn, ett formellt fullständigt beskrivande namn eller, om det är ett krav med klass eller enhetskategori.</items><items id="comment">Detta dataelement kommer att fånga den term, fras eller kategori som används i klinisk praktisk. Till exempel: &lt;maskin&gt; (XYZ Audiometer); &lt;storlek&gt; (14G Jelco IV kateter); eller &lt;implantat&gt;. Kodning med en terminologi är önskvärt, om möjligt, även om detta kan vara lokalt och beroende på tillgängliga lokala leveranser.</items></items><items code="at0002"><items id="text">Beskrivning</items><items id="description">Berättande beskrivning av den medicinska utrustningen.</items></items><items code="at0003"><items id="text">Typ</items><items id="description">Kategorin eller typen av utrustning.</items><items id="comment">Ej tillämpligt om en kategori redan har spelats in i "Namn på utrustning".&#13;
 Exempel: om "utrustning" heter som en "urinkateter"; 'Typ' kan registreras som 'kvarliggande' eller 'kondom'. Det är önskvärt att koda med en terminologi, där det är möjligt. Detta kan inkludera användning av GTIN- eller EAN-nummer.</items></items><items code="at0004"><items id="text">Tillverkare</items><items id="description">Tillverkares namn</items></items><items code="at0005"><items id="text">Tillverknings datum</items><items id="description">Datumet då utrustningen är tillverkade.</items></items><items code="at0006"><items id="text">Parti- / partinummer</items><items id="description">Det nummer som tillverkaren tilldelar, numret identifierar en grupp av artiklar som tillverkas samtidigt, vanligtvis finns på etiketten eller förpackningsmaterialet.</items></items><items code="at0007"><items id="text">Utgångsdatum</items><items id="description">Datum efter vilken utrustning/ produkt inte längre är lämplig att använda, vanligtvis finns på själva utrustningen eller tryckt på den medföljande förpackningen.</items><items id="comment">Detta datum gäller vanligtvis utrustning som ska användas en gång.</items></items><items code="at0008"><items id="text">kommentarer</items><items id="description">Ytterligare berättelse om utrustningen som inte är fångad i andra fält.</items></items><items code="at0009"><items id="text">Egenskaper</items><items id="description">Mer information om specifika egenskaper för den medicinska utrustningen.</items></items><items code="at0018"><items id="text">Komponenter</items><items id="description">Ytterligare strukturerad information om identifierade komponenter i utrustningen.</items></items><items code="at0019"><items id="text">Kapitalförvaltning</items><items id="description">Mer information om hantering och underhåll av utrustningen.</items><items id="comment">Till exempel: Ägare, kontaktuppgifter, plats, nätverksadress, datum för utbyte, kalibreringsinformation etc.</items></items><items code="at0020"><items id="text">serienummer</items><items id="description">Tilldelat nummer av tillverkaren på utrustningen, bör vara specifik för varje utrustning., Dess etikett eller medföljande förpackning. (Ett)</items></items><items code="at0021"><items id="text">Unik utrustningsidentifierare (UDI)</items><items id="description">En numerisk eller alfanumerisk sträng som är associerad med den här utrustningen i ett givet system.</items><items id="comment">Ofta fixad till utrustningen som streckkod.</items></items><items code="at0022"><items id="text">Katalognummer</items><items id="description">Det exakta nummer som tilldelats av tillverkaren och det visas i tillverkarens katalog, utrustnings märkning eller medföljande förpackning.</items></items><items code="at0023"><items id="text">Modellnummer</items><items id="description">Det exakta modellnummer som tilldelats av tillverkaren och finns på utrustnings etiketten eller medföljande förpackning.</items></items><items code="at0024"><items id="text">Annan identifierare</items><items id="description">Ospecificerad identifierare, som kan specificeras ytterligare i en mall eller vid körning.</items><items id="comment">Kodning av namnet på identifieraren med en kodverk är önskvärt, om det finns för området.</items></items><items code="at0025"><items id="text">Mjukvara-version</items><items id="description">Identifiering av den version av programvaran som används i den medicinska utrustningen.</items><items id="comment">När den medicinska utrustningen är en programvara, då får man registrera programversionen med detta dataelement. När den medicinska utrustningen har flera mjukvaruapplikationer inbäddade, får man registrera in varje programvara komponent i en separat CLUSTER-arketyp i Components SLOT - antingen som en kapslad instans av en annan CLUSTER. Device-arketyp eller med en CLUSTER-arketyp som är designad speciellt för registrering av programvara information ( just nu är detta inte tillgänglig vid utveckling av denna arketyp)</items></items><items code="at0026"><items id="text">Förlängning</items><items id="description">Ytterligare information krävs för att fånga lokalt sammanhang eller för att anpassa sig till andra referensmodeller / formalismer.</items></items><items code="at0027"><items id="text">Multimedia</items><items id="description">Digital representation av utrustning.</items><items id="comment">Till exempel: ett tekniskt diagram över en enhet eller en digital bild.</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_mass_index.v2"><term_definitions language="de"><items code="at0000"><items id="text">Body mass index</items><items id="description">Body Mass Index Errechnete Messung, die das Gewicht und die Größe einer Person misst.</items><items id="comment">Beim Body-Mass-Index handelt es sich um ein berechnetes Verhältnis, welches beschreibt, wie sich das Körpergewicht einer Person zu dem Gewicht verhält, das für die Größe der Person als normal oder wünschenswert angesehen wird.</items></items><items code="at0001"><items id="text">history</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Beliebiges Ereignis</items><items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items></items><items code="at0003"><items id="text">Single</items><items id="description">@ internal @</items></items><items code="at0004"><items id="text">Body mass index</items><items id="description">Der Index beschreibt das Verhältnis von Gewicht zu Körpergröße.</items></items><items code="at0005"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0006"><items id="text">Methode</items><items id="description">Die Methode zur Eingabe des Body-Mass-Index.</items></items><items code="at0007"><items id="text">Automatische Eingabe</items><items id="description">Der Body-Mass-Index wird ohne Benutzereingriff automatisch berechnet und eingegeben.</items></items><items code="at0008"><items id="text">Direkteingabe</items><items id="description">Der Body-Mass-Index wird direkt vom Benutzer berechnet und eingegeben.</items></items><items code="at0010"><items id="text">Formel</items><items id="description">Die Formel zur Ermittlung des Body-Mass-Index.</items></items><items code="at0011"><items id="text">Störfaktoren</items><items id="description">Beschreibung der Probleme oder Faktoren, die sich auf die Berechnung auswirken können.</items><items id="comment">Zum Beispiel: Die Berechnung wurde mit angepasstem Gewicht oder angepasster Körpergröße durchgeführt.</items></items><items code="at0012"><items id="text">Kommentar</items><items id="description">Beschreibung der Berechnung, die in anderen Feldern nicht erfasst wurden.</items></items><items code="at0013"><items id="text">Klinische Interpretation</items><items id="description">Einzelnes Wort, Phrase oder kurze Beschreibung, die die klinische Bedeutung und die Signifikanz des Body-Mass-Index darstellt.</items><items id="comment">Zum Beispiel: untergewichtig, normal, übergewichtig oder fettleibig.</items></items><items code="at0014"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0015"><items id="text">Erweiterungen</items><items id="description">Zusätzliche Informationen, die zur Erfassung lokaler Inhalte oder zur Anpassung an andere Referenzmodelle/Formalismen erforderlich sind.</items><items id="comment">Zum Beispiel: Lokale Informationsanforderungen oder zusätzliche Metadaten, um Verknüpfungen mit FHIR oder CIMI Äquivalenten herzustellen.</items></items><items code="kg/m2"><items id="text">kg/m²</items><items id="description">kg/m²</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="text">Kroppsmasseindex</items><items id="description">Beräknat mått som jämför en persons vikt och längd.</items></items><items code="at0001"><items id="text">history</items><items id="description">@ internal @</items></items><items code="at0002"><items id="text">Ospecificerad händelse</items><items id="description">Standard, ospecificerad händelse vid en tidpunkt eller ett tidsintervall som explicit kan definieras i en mall eller vid körning av program.</items></items><items code="at0003"><items id="text">Single</items><items id="description">@ internal @</items></items><items code="at0004"><items id="text">Kroppsmasseindex</items><items id="description">Index som beskriver förhållandet mellan vikt och höjd.</items></items><items code="at0005"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0006"><items id="text">Metod</items><items id="description">Metoden för inmatning av BMI.</items></items><items code="at0007"><items id="text">Automatisk inmatning</items><items id="description">BMI beräknas och matas in automatiskt utan åtgärder från användaren.</items></items><items code="at0008"><items id="text">Direkt inmatning</items><items id="description">BMI beräknas och matas in direkt av användaren.</items></items><items code="at0010"><items id="text">Formel</items><items id="description">Formel som används för att räkna ut en individs BMI.</items></items><items code="at0011"><items id="text">Påverkande faktorer</items><items id="description">Redogörelse för eventuella problem eller faktorer som kan påverka beräkningen.</items><items id="comment">Exempelvis: beräkningen gjordes med hjälp av justerad vikt eller längd.</items></items><items code="at0012"><items id="text">Kommentar</items><items id="description">Ytterligare kommentar om beräkningen som inte tagits med i andra fält.</items></items><items code="at0013"><items id="text">Klinisk tolkning</items><items id="description">Ett ord, en fras eller en kort beskrivning om den kliniska betydelsen av BMI.</items><items id="comment">Exempelvis: underviktig, normal, överviktig eller fet.</items></items><items code="at0014"><items id="text">Tree</items><items id="description">@ internal @</items></items><items code="at0015"><items id="text">Extra information</items><items id="description">Extra information som krävs för att fånga lokal kontext eller för anpassning till andra referensmodeller och formalismer.</items><items id="comment">Exempelvis: avdelningsinformation från det lokala sjukhuset eller ytterligare metadata för anpassning till FHIR- eller CIMI- motsvarigheter.</items></items><items code="kg/m2"><items id="text">kg/m²</items><items id="description">kg/m²</items></items></term_definitions></component_ontologies></template>